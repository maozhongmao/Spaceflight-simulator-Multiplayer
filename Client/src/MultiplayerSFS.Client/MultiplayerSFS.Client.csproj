<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <AssemblyName>SFS-Multiplayer-1.6-V1.0.6.2</AssemblyName>
    <RootNamespace>MultiplayerSFS</RootNamespace>
    <LangVersion>12.0</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <GameVersion Condition="'$(GameVersion)' == ''">v16</GameVersion>
    <GameReferences>$(MSBuildProjectDirectory)\..\..\refs\$(GameVersion)</GameReferences>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <OutputPath>$(MSBuildProjectDirectory)\..\..\artifacts\$(GameVersion)\</OutputPath>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="Assembly-CSharp" HintPath="$(GameReferences)\Assembly-CSharp.dll" Private="false" />
    <Reference Include="Assembly-CSharp-firstpass" HintPath="$(GameReferences)\Assembly-CSharp-firstpass.dll" Private="false" />
    <Reference Include="0Harmony" HintPath="$(GameReferences)\0Harmony.dll" Private="false" />
    <Reference Include="Lidgren.Network" HintPath="$(GameReferences)\Lidgren.Network.dll" Private="false" />
    <Reference Include="UITools" HintPath="$(GameReferences)\UITools.dll" Private="false" />
    <Reference Include="Unity.TextMeshPro" HintPath="$(GameReferences)\Unity.TextMeshPro.dll" Private="false" />
    <Reference Include="UnityEngine" HintPath="$(GameReferences)\UnityEngine.dll" Private="false" />
    <Reference Include="UnityEngine.CoreModule" HintPath="$(GameReferences)\UnityEngine.CoreModule.dll" Private="false" />
    <Reference Include="UnityEngine.InputLegacyModule" HintPath="$(GameReferences)\UnityEngine.InputLegacyModule.dll" Private="false" />
    <Reference Include="UnityEngine.IMGUIModule" HintPath="$(GameReferences)\UnityEngine.IMGUIModule.dll" Private="false" />
    <Reference Include="UnityEngine.Physics2DModule" HintPath="$(GameReferences)\UnityEngine.Physics2DModule.dll" Private="false" />
    <Reference Include="UnityEngine.TextRenderingModule" HintPath="$(GameReferences)\UnityEngine.TextRenderingModule.dll" Private="false" />
    <Reference Include="UnityEngine.UI" HintPath="$(GameReferences)\UnityEngine.UI.dll" Private="false" />
    <Reference Include="UnityEngine.UnityAnalyticsModule" HintPath="$(GameReferences)\UnityEngine.UnityAnalyticsModule.dll" Private="false" />
  </ItemGroup>
</Project>
